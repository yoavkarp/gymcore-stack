#set($clubId = $ctx.identity.sub)

{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "workouts-by-club-library",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#clubId#lib",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("6334c862-6041-7018-7094-9d7686054bd9#$clubId#1"),
    }
  }
}