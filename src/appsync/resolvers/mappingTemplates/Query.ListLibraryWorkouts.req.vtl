#set($clubId = $ctx.identity.sub)

{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "workouts-by-club-library",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#clubId#lib",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("23b498e2-f0c1-7047-3bd1-a9fe0cd7f383#$clubId#1"),
    }
  }
}