#set($clubId = $ctx.identity.sub)


{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "workouts-by-club-library",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#clubId#lib",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("$tenantId#$clubId#1"),
    }
  }
}