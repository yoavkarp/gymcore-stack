#set($clubId = $ctx.identity.sub)

{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "library-by-club-id",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "clubId",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("$clubId"),
    }
  }
}