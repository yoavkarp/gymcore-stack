#set($tenantId = $ctx.identity.claims.get("custom:tenantId"))
#set($memberId = $ctx.source.id)

{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "plans-by-member-id",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 10),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#memberId",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("$tenantId#$memberId"),
    }
  }
}