#set($clubId = $ctx.identity.sub)


{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "plans-by-member-id",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#memberId",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("$tenantId#$ctx.args.memberId"),
    }
  }
}