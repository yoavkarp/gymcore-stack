#set($memberId = $ctx.identity.sub)


{
  "version": "2018-05-29",
  "operation": "Query",
  "index": "active-workouts-by-member-id",
  "limit": $util.defaultIfNull(${ctx.args.limit}, 5),
  "scanIndexForward": false,
  "query": {
    "expression": "#PK = :PK",
    "expressionNames": {
      "#PK": "tenantId#memberId",
    },
    "expressionValues": {
      ":PK": $util.dynamodb.toStringJson("$tenantId#$memberId"),
    }
  },
  "filter": {
    "expression": "attribute_exists(end_at)",
  }
}