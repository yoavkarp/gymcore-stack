{
  "name": "gymcore-cdk",
  "version": "0.1.0",
  "bin": {
    "gymcore-cdk": "bin/gymcore-cdk.js"
  },
  "scripts": {
    "build": "ts-node scripts/build",
    "cdk": "cdk",
    "test": "jest",
    "ydeploy": "npx aws-cdk deploy --all --outputs-file outputs/cdk-output.json --require-approval never --profile pumpreact",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "publish": "npm run build; npm run ydeploy",
    "create-tenant": "ts-node scripts/create-tenant",
    "create-club": "ts-node scripts/create-club",
    "layers": "ts-node scripts/install-layer-modules.ts"
  },
  "devDependencies": {
    "@aws-crypto/client-node": "^4.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^4.3.0",
    "@graphql-codegen/typescript-resolvers": "^4.2.1",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.7",
    "@types/aws-lambda": "^8.10.142",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "aws-cdk": "^2.173.4",
    "chalk": "^4.1.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@apollo/client": "^3.11.5",
    "@aws-cdk/aws-appsync": "^1.204.0",
    "@aws-cdk/aws-appsync-alpha": "^2.59.0-alpha.0",
    "@aws-cdk/aws-cognito-identitypool-alpha": "^2.173.4-alpha.0",
    "@graphql-codegen/cli": "^5.0.2",
    "amazon-cognito-identity-js": "^6.3.12",
    "aws-cdk-lib": "^2.173.4",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.4.2",
    "nodemailer": "^7.0.2",
    "zod": "^3.23.8"
  }
}
