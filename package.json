{
  "name": "gymcore-cdk",
  "version": "0.1.0",
  "bin": {
    "gymcore-cdk": "bin/gymcore-cdk.js"
  },
  "scripts": {
    "build": "tsc && graphql-codegen --config codegen.config.ts",
    "cdk": "cdk",
    "test": "jest",
    "ydeploy": "npx aws-cdk deploy --all --outputs-file outputs/cdk-output.json --require-approval never --profile yoav",
    "codegen": "graphql-codegen --config codegen.config.ts"
  },
  "devDependencies": {
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^4.3.0",
    "@graphql-codegen/typescript-resolvers": "^4.2.1",
    "@types/aws-lambda": "^8.10.142",
    "@types/node": "^22.0.0",
    "aws-cdk": "2.150.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@apollo/client": "^3.11.5",
    "@aws-cdk/aws-appsync": "^1.204.0",
    "@aws-cdk/aws-appsync-alpha": "^2.59.0-alpha.0",
    "@aws-cdk/aws-cognito-identitypool-alpha": "^2.150.0-alpha.0",
    "@graphql-codegen/cli": "^5.0.2",
    "amazon-cognito-identity-js": "^6.3.12",
    "aws-cdk-lib": "2.150.0",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1664.0",
    "constructs": "^10.0.0",
    "mongoose": "^6.13.0",
    "zod": "^3.23.8"
  }
}
